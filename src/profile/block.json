{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "versedb/profile",
	"version": "1.0.0",
	"title": "VerseDB Profile",
	"category": "versedb",
	"icon": "book",
	"description": "Display your VerseDB profile.",
	"textdomain": "versedb",
	"attributes": {
		"showAvatar": {
			"type": "boolean",
			"default": true
		},
		"showBio": {
			"type": "boolean",
			"default": true
		},
		"showBanner": {
			"type": "boolean",
			"default": false
		},
		"showStats": {
			"type": "boolean",
			"default": false
		},
		"avatarSize": {
			"type": "number",
			"default": 80
		},
		"avatarShape": {
			"type": "string",
			"enum": [ "circle", "square" ],
			"default": "circle"
		},
		"avatarRadius": {
			"type": "number",
			"default": 0
		},
		"enableLinks": {
			"type": "boolean",
			"default": true
		},
		"customLayout": {
			"type": "boolean",
			"default": false
		},
		"layoutInitialized": {
			"type": "boolean",
			"default": false
		},
		"layoutVersion": {
			"type": "number",
			"default": 0
		},
		"headingStyle": {
			"type": "object",
			"default": {}
		},
		"creditStyle": {
			"type": "object",
			"default": {}
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"color": {
			"text": true,
			"background": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	},
	"editorScript": "file:./index.js",
	"style": "versedb-display",
	"render": "file:./render.php"
}
